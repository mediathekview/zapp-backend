{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"lib": ["esnext"],
		"types": ["node"],
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"include": [
			"src/**/*"
		],
		"exclude": [
			"node_modules"
		]
	}
}
